# @lam/vulture/ws-plugin adds WebSocket routes to @lam/vulture.
# Import with: from @lam/vulture/ws-plugin import WebSocket, wsRoute, wsUpgrade

from @lam/vulture import Server, Request, Response, RouteOptions
from lamerrors import Result, Error

go! {
    import (
        "fmt"
        "net/http"

        "github.com/gorilla/websocket"
    )

    func lamWsStringList(value interface{}, name string) ([]string, error) {
        if value == nil {
            return nil, nil
        }
        switch list := value.(type) {
        case []string:
            out := append([]string(nil), list...)
            for _, item := range out {
                if item == "" {
                    return nil, fmt.Errorf("%s entries must not be empty", name)
                }
            }
            return out, nil
        case []interface{}:
            out := make([]string, 0, len(list))
            for _, value := range list {
                item, ok := value.(string)
                if !ok || item == "" {
                    return nil, fmt.Errorf("%s must contain only non-empty strings", name)
                }
                out = append(out, item)
            }
            return out, nil
        default:
            return nil, fmt.Errorf("%s must be a list of strings", name)
        }
    }

    // WebSocket-specific values live in RouteOptions.meta so one typed options
    // object carries both Vulture route hooks/limits and upgrade configuration.
    func lamWsBuildUpgrader(opts *RouteOptions) (*websocket.Upgrader, error) {
        u := &websocket.Upgrader{
            ReadBufferSize:  1024,
            WriteBufferSize: 1024,
        }
        if opts == nil {
            u.CheckOrigin = func(r *http.Request) bool { return true }
            return u, nil
        }

        meta := opts.Meta
        protocols, err := lamWsStringList(meta["subprotocols"], "subprotocols")
        if err != nil {
            return nil, err
        }
        origins, err := lamWsStringList(meta["originAllowList"], "originAllowList")
        if err != nil {
            return nil, err
        }
        compression := false
        if value, exists := meta["compression"]; exists {
            enabled, ok := value.(bool)
            if !ok {
                return nil, fmt.Errorf("compression must be a bool")
            }
            compression = enabled
        }

        u.Subprotocols = protocols
        u.EnableCompression = compression
        if len(origins) == 0 {
            u.CheckOrigin = func(r *http.Request) bool { return true }
        } else {
            allow := make(map[string]struct{}, len(origins))
            for _, origin := range origins {
                allow[origin] = struct{}{}
            }
            u.CheckOrigin = func(r *http.Request) bool {
                _, ok := allow[r.Header.Get("Origin")]
                return ok
            }
        }
        return u, nil
    }
}

class WebSocket {
    #- Wraps a ``*websocket.Conn`` after a successful HTTP upgrade.
    Message operations use Result values so an empty frame, a normal close,
    and a transport failure are never represented by the same sentinel. -#

    func init(self) {
        self.conn: any = None
        self.closed: bool = false
        self.subprotocol: str = ""
    }

    func send(self, msg: str) -> Result[bool] {
        #- Send one text message. -#
        if self.closed {
            return Result.Err(Error("WebSocketClosedError", "the connection is closed", None))
        }
        go! {
            c, ok := s.Conn.(*websocket.Conn)
            if !ok {
                s.Closed = true
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "WebSocketConnectionError", "the native connection is unavailable", nil,
                ))
            }
            if err := c.WriteMessage(websocket.TextMessage, []byte(msg)); err != nil {
                s.Closed = true
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "WebSocketSendError", err.Error(), nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func sendBytes(self, data: any) -> Result[bool] {
        #- Send a native Go ``[]byte`` as one binary message. -#
        if self.closed {
            return Result.Err(Error("WebSocketClosedError", "the connection is closed", None))
        }
        go! {
            c, ok := s.Conn.(*websocket.Conn)
            if !ok {
                s.Closed = true
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "WebSocketConnectionError", "the native connection is unavailable", nil,
                ))
            }
            buf, ok := data.([]byte)
            if !ok {
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "WebSocketDataError", "sendBytes requires a native []byte", nil,
                ))
            }
            if err := c.WriteMessage(websocket.BinaryMessage, buf); err != nil {
                s.Closed = true
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "WebSocketSendError", err.Error(), nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func receive(self) -> Result[str] {
        #- Block for the next text message, skipping binary messages.
        An empty text frame is ``Ok("")``; close and read failures are errors. -#
        if self.closed {
            return Result.Err(Error("WebSocketClosedError", "the connection is closed", None))
        }
        go! {
            c, ok := s.Conn.(*websocket.Conn)
            if !ok {
                s.Closed = true
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "WebSocketConnectionError", "the native connection is unavailable", nil,
                ))
            }
            for {
                messageType, message, err := c.ReadMessage()
                if err != nil {
                    s.Closed = true
                    if websocket.IsCloseError(
                        err,
                        websocket.CloseNormalClosure,
                        websocket.CloseGoingAway,
                        websocket.CloseNoStatusReceived,
                    ) {
                        return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                            "WebSocketClosedError", err.Error(), nil,
                        ))
                    }
                    return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                        "WebSocketReceiveError", err.Error(), nil,
                    ))
                }
                if messageType == websocket.TextMessage {
                    return LAMMERGEIER.Result.Ok(string(message))
                }
            }
        }
    }

    func receiveBytes(self) -> Result[any] {
        #- Block for the next binary message, skipping text messages.
        An empty byte slice is successful; close and read failures are errors. -#
        if self.closed {
            return Result.Err(Error("WebSocketClosedError", "the connection is closed", None))
        }
        go! {
            c, ok := s.Conn.(*websocket.Conn)
            if !ok {
                s.Closed = true
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "WebSocketConnectionError", "the native connection is unavailable", nil,
                ))
            }
            for {
                messageType, message, err := c.ReadMessage()
                if err != nil {
                    s.Closed = true
                    if websocket.IsCloseError(
                        err,
                        websocket.CloseNormalClosure,
                        websocket.CloseGoingAway,
                        websocket.CloseNoStatusReceived,
                    ) {
                        return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                            "WebSocketClosedError", err.Error(), nil,
                        ))
                    }
                    return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                        "WebSocketReceiveError", err.Error(), nil,
                    ))
                }
                if messageType == websocket.BinaryMessage {
                    return LAMMERGEIER.Result.Ok(message)
                }
            }
        }
    }

    func ping(self) -> Result[bool] {
        #- Send a control-frame ping for application-managed keep-alive. -#
        if self.closed {
            return Result.Err(Error("WebSocketClosedError", "the connection is closed", None))
        }
        go! {
            c, ok := s.Conn.(*websocket.Conn)
            if !ok {
                s.Closed = true
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "WebSocketConnectionError", "the native connection is unavailable", nil,
                ))
            }
            if err := c.WriteMessage(websocket.PingMessage, nil); err != nil {
                s.Closed = true
                return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                    "WebSocketSendError", err.Error(), nil,
                ))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func close(self) {
        #- Send a normal Close frame and close the connection. Idempotent. -#
        if self.closed {
            return
        }
        go! {
            s.Closed = true
            c, ok := s.Conn.(*websocket.Conn)
            if !ok {
                return
            }
            _ = c.WriteMessage(
                websocket.CloseMessage,
                websocket.FormatCloseMessage(websocket.CloseNormalClosure, ""),
            )
            _ = c.Close()
        }
    }

    func isClosed(self) -> bool {
        return self.closed
    }

    func rawConn(self) -> any {
        #- Return the underlying ``*websocket.Conn`` for advanced native use. -#
        return self.conn
    }
}

func wsValidateOptions(opts: RouteOptions) -> Result[bool] {
    #- Validate WebSocket values stored in ``RouteOptions.meta``. -#
    go! {
        _, err := lamWsBuildUpgrader(opts)
        if err != nil {
            return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                "WebSocketConfigurationError", err.Error(), nil,
            ))
        }
        return LAMMERGEIER.Result.Ok(true)
    }
}

func wsUpgrade(req: Request, res: Response, opts: RouteOptions) -> Result[WebSocket] {
    #- Upgrade a live HTTP request. Configuration and handshake failures are
    returned as typed errors. Gorilla may already have written the handshake
    failure response; Vulture is marked hijacked to prevent a second write. -#
    configuration: Result[bool] = wsValidateOptions(opts)
    if not configuration.ok() {
        res.code(500).text("ws: invalid configuration: " + str(configuration.error))
        return Result.Err(configuration.error)
    }

    rawReady: bool = false
    go! {
        _, writerOK := req.RawWriter.(http.ResponseWriter)
        _, requestOK := req.RawHttp.(*http.Request)
        rawReady = writerOK && requestOK
    }
    if not rawReady {
        res.code(500).text("ws: not on http path")
        return Result.Err(Error(
        "WebSocketUpgradeError",
        "the request does not expose a native HTTP writer and request",
        None,
        ))
    }

    go! {
        w := req.RawWriter.(http.ResponseWriter)
        r := req.RawHttp.(*http.Request)
        upgrader, configErr := lamWsBuildUpgrader(opts)
        if configErr != nil {
            return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                "WebSocketConfigurationError", configErr.Error(), nil,
            ))
        }
        conn, err := upgrader.Upgrade(w, r, nil)
        if err != nil {
            res.Hijacked = true
            res.Sent = true
            return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                "WebSocketUpgradeError", err.Error(), nil,
            ))
        }
        res.Hijacked = true
        res.Sent = true
        ws := NewWebSocket()
        ws.Conn = conn
        ws.Subprotocol = conn.Subprotocol()
        return LAMMERGEIER.Result.Ok(ws)
    }
}

func wsBoundHandler(req: Request) -> func(WebSocket, Request) {
    go! {
        return req.Ctx.GetItem("__wsHandler").(func(*WebSocket, *Request))
    }
}

func wsBoundOptions(req: Request) -> RouteOptions {
    go! {
        return req.Ctx.GetItem("__wsOptions").(*RouteOptions)
    }
}

func wsRouteHandler(req: Request, res: Response) {
    #- Internal typed Vulture handler. The route-local preHandler places the
    callback and options in request context before this runs. -#
    handler: func(WebSocket, Request) = wsBoundHandler(req)
    opts: RouteOptions = wsBoundOptions(req)
    upgraded: Result[WebSocket] = wsUpgrade(req, res, opts)
    if not upgraded.ok() {
        return
    }
    ws: WebSocket = upgraded.unwrap()
    defer ws.close()
    handler(ws, req)
}

func wsBindingHook(
handler: func(WebSocket, Request),
opts: RouteOptions,
) -> func(Request, Response) {
    #- Build the one native capturing callback required to bind route-local
    WebSocket state. Registration still goes through RouteOptions.preHandler. -#
    go! {
        previous := opts.PreHandlerHook
        return func(req *Request, res *Response) {
            if hook, ok := previous.(func(*Request, *Response)); ok {
                hook(req, res)
            }
            req.Ctx.Set("__wsHandler", handler)
            req.Ctx.Set("__wsOptions", opts)
        }
    }
}

func wsRoute(
srv: Server,
path: str,
handler: func(WebSocket, Request),
) -> Result[bool] {
    #- Register a permissive WebSocket GET endpoint. -#
    return wsRoute(srv, path, handler, RouteOptions())
}

func wsRoute(
srv: Server,
path: str,
handler: func(WebSocket, Request),
opts: RouteOptions,
) -> Result[bool] {
    #- Register a WebSocket GET endpoint with Vulture's typed RouteOptions.
    WebSocket metadata keys are ``originAllowList``, ``subprotocols``, and
    ``compression``. Invalid metadata returns WebSocketConfigurationError. -#
    if path == "" {
        return Result.Err(Error(
        "WebSocketConfigurationError",
        "the route path must not be empty",
        None,
        ))
    }
    configuration: Result[bool] = wsValidateOptions(opts)
    if not configuration.ok() {
        return configuration
    }
    binding: func(Request, Response) = wsBindingHook(handler, opts)
    opts = opts.preHandler(binding)
    srv.get(path, wsRouteHandler, opts)
    return Result.Ok(true)
}
